pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {
    stage('Test') {
      agent {
        docker {
          image 'python:3.12-slim'
          reuseNode true
        }
      }
      steps {
        sh 'python -m pip install --requirement requirements-dev.txt'
        sh 'pytest --junitxml=report.xml'
      }
      post {
        always {
          junit 'report.xml'
        }
      }
    }

    stage('Build') {
      steps {
        sh 'docker build --tag visits-api:${GIT_COMMIT} .'
      }
    }
  }
}
